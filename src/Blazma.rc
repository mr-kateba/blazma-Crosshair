// Icon, manifest and version metadata for BlazmaOverlay.exe.
// Without a version block Windows shows blank fields in file properties, which
// looks unfinished to anyone inspecting a downloaded binary.

#include <windows.h>

1 ICON "../assets/blazma.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Blazma.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Blazma"
            VALUE "FileDescription",  "Blazma crosshair overlay"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "BlazmaOverlay"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Blazma"
            VALUE "OriginalFilename", "BlazmaOverlay.exe"
            VALUE "ProductName",      "Blazma"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
