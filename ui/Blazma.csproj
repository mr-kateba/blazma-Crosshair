<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by the LibraryImport source generator used for the Win32 calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>Blazma</AssemblyName>
    <RootNamespace>Blazma</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/blazma.ico</ApplicationIcon>

    <!-- Shown in Windows file properties and by Steam's binary inspection. -->
    <Product>Blazma</Product>
    <AssemblyTitle>Blazma</AssemblyTitle>
    <Company>Blazma</Company>
    <Description>Blazma crosshair overlay</Description>
    <Copyright>Copyright (C) 2026 Blazma</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Published self-contained so the UI has no runtime prerequisites, matching
         the dependency-free native overlay it sits next to. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Keeps the ~100 MB of Skia/HarfBuzz native .pdb files out of the output. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../assets/blazma.ico" Link="Assets/blazma.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
  </ItemGroup>

</Project>
