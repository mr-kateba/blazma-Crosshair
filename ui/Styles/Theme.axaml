<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Section heading: tracked-out technical caps, the instrument-panel voice. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontFamily" Value="{DynamicResource TechFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.8" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource ChalkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Numeric readouts stay monospaced so values do not jitter while dragging. -->
  <Style Selector="TextBlock.readout">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
  </Style>

  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontFamily" Value="{DynamicResource TechFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="3" />
    <Setter Property="Foreground" Value="{StaticResource ChalkBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Border.rule">
    <Setter Property="Background" Value="{StaticResource RuleBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- Preset chip. The accent arrives only on hover, so the resting state stays quiet. -->
  <Style Selector="Button.preset">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ChalkBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.preset:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.preset:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
  </Style>

  <!-- Primary action. The only filled accent surface in the window. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#121016" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#A29AEE" />
    <Setter Property="TextElement.Foreground" Value="#121016" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ChalkBrush}" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GraphiteBrush}" />
  </Style>

  <!-- Window chrome buttons. -->
  <Style Selector="Button.chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource ChalkBrush}" />
  </Style>

  <Style Selector="Button.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Colour swatch. Scales up slightly on hover rather than changing colour. -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.swatch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>

  <!-- Zoom selector chips. -->
  <Style Selector="ToggleButton.zoom">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
  </Style>

  <!-- Language chips carry Arabic and CJK text, so they use the body face. -->
  <Style Selector="ToggleButton.lang">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="11,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
  </Style>

  <Style Selector="ToggleButton.lang:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.lang:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>

  <Style Selector="ToggleButton.zoom:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.zoom:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="0" />
  </Style>

</Styles>
