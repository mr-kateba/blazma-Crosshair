<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The Blazma design tokens, shared with Blazma Boost, Blazma Get and Blazma Cyber:
    near-black background, raised panels, soft borders, muted secondary text and the
    Blazma orange - the same orange as the hexagon in the app icon.
  -->
  <Color x:Key="VoidColor">#121216</Color>
  <Color x:Key="PanelColor">#1C1C22</Color>
  <Color x:Key="FieldColor">#0D0D10</Color>
  <Color x:Key="RuleColor">#2A2A33</Color>
  <Color x:Key="GraphiteColor">#A0A0AB</Color>
  <Color x:Key="ChalkColor">#F2F2F5</Color>
  <Color x:Key="OrangeColor">#FF6D00</Color>

  <SolidColorBrush x:Key="BenchBrush" Color="{StaticResource VoidColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
  <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
  <SolidColorBrush x:Key="ChalkBrush" Color="{StaticResource ChalkColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource OrangeColor}" />
  <!-- Orange for text and titles, a touch lighter so it reads on the dark background. -->
  <SolidColorBrush x:Key="AccentTextBrush" Color="#FF8A1F" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8A1F" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#E65100" />
  <!-- Rim around a selected (orange) key. -->
  <SolidColorBrush x:Key="AccentRimBrush" Color="#FFB066" />
  <!-- Text and glyphs drawn on an orange fill. -->
  <SolidColorBrush x:Key="OnAccentBrush" Color="#F7F7F7" />
  <!-- Blazma Boost's buttons: dark fill, light outline, lighter fill under the mouse. -->
  <SolidColorBrush x:Key="KeyOutlineBrush" Color="#C8C8CE" />
  <SolidColorBrush x:Key="HoverBrush" Color="#2E2E38" />

  <!-- The Blazma hexagon: amber at the top to deep orange at the bottom. -->
  <LinearGradientBrush x:Key="LogoBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="#FFB300" />
    <GradientStop Offset="1" Color="#FF3D00" />
  </LinearGradientBrush>

  <!--
    Bahnschrift is the DIN-derived technical face that ships with Windows 10/11 -
    it reads as instrument labelling rather than app chrome, and it covers Cyrillic.
    Cascadia Mono carries the numeric readouts; Inter is bundled for body copy.
    Arabic and CJK swap these at runtime - see Strings.cs.
  -->
  <FontFamily x:Key="TechFont">Bahnschrift,Segoe UI,sans-serif</FontFamily>
  <FontFamily x:Key="BodyFont">Inter,Segoe UI,sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,monospace</FontFamily>

  <!--
    Recolouring the Fluent accent ramp retints sliders, toggles, combo highlights
    and focus rings in one place, instead of retemplating each control.
  -->
  <Color x:Key="SystemAccentColor">#FF6D00</Color>
  <Color x:Key="SystemAccentColorLight1">#FF8A1F</Color>
  <Color x:Key="SystemAccentColorLight2">#FFA54D</Color>
  <Color x:Key="SystemAccentColorLight3">#FFB066</Color>
  <Color x:Key="SystemAccentColorDark1">#E65100</Color>
  <Color x:Key="SystemAccentColorDark2">#C24400</Color>
  <Color x:Key="SystemAccentColorDark3">#9E3700</Color>

</ResourceDictionary>
