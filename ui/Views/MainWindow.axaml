<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Blazma.Controls"
        xmlns:vm="using:Blazma.ViewModels"
        x:Class="Blazma.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Blazma"
        Icon="avares://Blazma/Assets/blazma.ico"
        Width="960" Height="740"
        MinWidth="880" MinHeight="600"
        Background="{StaticResource BenchBrush}"
        FontFamily="{DynamicResource BodyFont}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly">

  <!-- Arabic mirrors the entire window, chrome included. -->
  <Grid RowDefinitions="34,*" FlowDirection="{Binding FlowDirection}">

    <!-- Title bar ................................................. -->
    <Grid Grid.Row="0" Name="TitleBar" Background="{StaticResource BenchBrush}"
          ColumnDefinitions="Auto,*,Auto">

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                  Margin="16,0,0,0" VerticalAlignment="Center">
        <Border Width="3" Height="13" Background="{StaticResource AccentBrush}" />
        <TextBlock Classes="wordmark" Text="BLAZMA" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Classes="chrome" Name="MinimiseButton" Content="&#xE921;"
                FontFamily="Segoe MDL2 Assets" />
        <Button Classes="chrome close" Name="CloseButton" Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets" />
      </StackPanel>
    </Grid>

    <!-- Body ...................................................... -->
    <Grid Grid.Row="1" ColumnDefinitions="380,1,*">

      <!-- Calibration bench ....................................... -->
      <DockPanel Grid.Column="0" Margin="20,4,20,20">

        <StackPanel DockPanel.Dock="Bottom" Spacing="14" Margin="0,16,0,0">

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="{Binding Text.PreviewScale}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <ToggleButton Classes="zoom" Content="1x" IsChecked="{Binding IsZoom1}" />
              <ToggleButton Classes="zoom" Content="2x" IsChecked="{Binding IsZoom2}" />
              <ToggleButton Classes="zoom" Content="4x" IsChecked="{Binding IsZoom4}" />
            </StackPanel>
          </Grid>

          <Border Classes="rule" />

          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="{Binding Text.Subtension}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="readout" Text="{Binding SubtensionText}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="{Binding Text.Opacity}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="readout" Margin="0,6,0,0"
                       Text="{Binding OpacityPercent, StringFormat='{}{0}%'}" />
          </Grid>

          <Border Classes="rule" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="{Binding Text.LanguageLabel}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <ToggleButton Classes="lang" Content="EN" IsChecked="{Binding IsEnglish}" />
              <ToggleButton Classes="lang" Content="РУ" IsChecked="{Binding IsRussian}" />
              <ToggleButton Classes="lang" Content="عربي" IsChecked="{Binding IsArabic}" />
              <ToggleButton Classes="lang" Content="中文" IsChecked="{Binding IsChinese}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <Border Classes="panel" Background="{StaticResource FieldBrush}" ClipToBounds="True">
          <!-- The instrument surface itself never mirrors; a reticle has no handedness. -->
          <Grid FlowDirection="LeftToRight">
            <c:CalibrationField RuleBrush="{StaticResource RuleBrush}"
                                HairlineBrush="#242B34" />
            <c:CrosshairPreview Type="{Binding Type}"
                                Color="{Binding Color}"
                                Size="{Binding Size}"
                                Thickness="{Binding Thickness}"
                                Gap="{Binding Gap}"
                                Outline="{Binding Outline}"
                                CrosshairOpacity="{Binding Opacity}"
                                Zoom="{Binding Zoom}" />
          </Grid>
        </Border>
      </DockPanel>

      <Border Grid.Column="1" Background="{StaticResource RuleBrush}" />

      <!-- Controls ................................................. -->
      <ScrollViewer Grid.Column="2" Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel Margin="24,4,24,24" Spacing="22">

          <!-- Presets -->
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="{Binding Text.Presets}" />
            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetOption">
                  <Button Classes="preset"
                          Content="{Binding Name}"
                          ToolTip.Tip="{Binding Description}"
                          Margin="0,0,8,8"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ApplyPresetCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Form -->
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{Binding Text.Form}" />

            <Grid ColumnDefinitions="130,*">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.Shape}" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Shapes}"
                        SelectedItem="{Binding SelectedShape}"
                        DisplayMemberBinding="{Binding Label}" />
            </Grid>

            <Grid ColumnDefinitions="130,*,56">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.Size}" />
              <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding Size}" />
              <TextBlock Grid.Column="2" Classes="readout" Text="{Binding Size}" />
            </Grid>

            <Grid ColumnDefinitions="130,*,56">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.Thickness}" />
              <Slider Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding Thickness}" />
              <TextBlock Grid.Column="2" Classes="readout" Text="{Binding Thickness}" />
            </Grid>

            <Grid ColumnDefinitions="130,*,56">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.CentreGap}" />
              <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding Gap}" />
              <TextBlock Grid.Column="2" Classes="readout" Text="{Binding Gap}" />
            </Grid>

            <Grid ColumnDefinitions="130,*">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.DarkOutline}" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Outline}"
                            OnContent="{Binding Text.On}" OffContent="{Binding Text.Off}"
                            HorizontalAlignment="Left" />
            </Grid>
          </StackPanel>

          <Border Classes="rule" />

          <!-- Colour -->
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{Binding Text.Colour}" />

            <Grid ColumnDefinitions="130,Auto,Auto,*,Auto">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.Reticle}" />

              <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="7" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="swatch"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PickSwatchCommand}"
                            CommandParameter="{Binding}">
                      <Button.Background>
                        <SolidColorBrush Color="{Binding}" />
                      </Button.Background>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ColorPicker Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                           Color="{Binding Color}"
                           IsAlphaVisible="False"
                           IsColorPaletteVisible="False"
                           ToolTip.Tip="{Binding Text.CustomColour}" />

              <TextBlock Grid.Column="4" Classes="readout" Text="{Binding ColorHex}" />
            </Grid>

            <Grid ColumnDefinitions="130,*,56">
              <TextBlock Grid.Column="0" Classes="label" Text="{Binding Text.Opacity}" />
              <Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding Opacity}" />
              <TextBlock Grid.Column="2" Classes="readout"
                         Text="{Binding OpacityPercent, StringFormat='{}{0}%'}" />
            </Grid>
          </StackPanel>

          <Border Classes="rule" />

          <!-- Overlay -->
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{Binding Text.Overlay}" />

            <StackPanel Orientation="Horizontal" Spacing="9">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{StaticResource AccentBrush}"
                       IsVisible="{Binding IsOverlayRunning}" />
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                       Fill="{StaticResource GraphiteBrush}"
                       IsVisible="{Binding !IsOverlayRunning}" />
              <TextBlock Classes="label" Text="{Binding OverlayStatusText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="9">
              <Button Classes="primary" Content="{Binding OverlayActionText}"
                      Command="{Binding ToggleOverlayCommand}" />
              <Button Classes="ghost" Content="{Binding Text.Stop}"
                      Command="{Binding StopOverlayCommand}" />
              <Button Classes="ghost" Content="{Binding Text.Reset}"
                      Command="{Binding ResetCommand}" />
            </StackPanel>

            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Text.Hint}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
